{
  "name": "know-your-meme-desktop",
  "version": "1.0.0",
  "type": "module",
  "description": "Desktop application for managing, tagging and exploring your meme collection",
  "main": "dist-electron/main/index.js",
  "author": "Michał",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "build:dir": "npm run build && electron-builder --dir && node scripts/set-icon.cjs",
    "build:win": "npm run build && electron-builder --win && node scripts/set-icon.cjs",
    "build:portable": "npm run build && electron-builder --win portable && node scripts/set-icon.cjs",
    "set-icon": "node scripts/set-icon.cjs"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "lucide-vue-next": "^0.475.0",
    "pinia": "^3.0.1",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.12.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.2",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.knowyourmeme.desktop",
    "productName": "Know Your Meme Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "resources"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
